        <mxCell id="mail" value="&lt;b&gt;メール配信サービス&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;任意構成&lt;br&gt;会員承認・新着相談の通知&lt;br&gt;本文に相談内容を含めない&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;strokeWidth=1.4;fillColor=#F5F0FA;strokeColor=#9383A6;fontColor=#51445f;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1660" y="245" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ops" value="&lt;b&gt;運用・保守基盤&lt;/b&gt;&lt;br&gt;&lt;br&gt;コンテナログ・監視・エラー調査&lt;br&gt;DB日次バックアップ（暗号化）&lt;br&gt;バックアップ30日保持（案）&lt;br&gt;復元手順・障害時の案内&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#68756e&quot;&gt;パスワード・相談本文をログに残さない&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.4;fillColor=#F0F2F0;strokeColor=#8C9990;fontColor=#3F5047;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1660" y="520" width="300" height="235" as="geometry" />
        </mxCell>
        <mxCell id="security-note" value="&lt;b&gt;保護方針&lt;/b&gt;　HTTPS通信｜DBは内部ネットワーク｜パスワードはハッシュ保存｜権限はAPI側で検証" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;strokeColor=#D8E1D8;fillColor=#FFFFFF;fontColor=#506158;fontSize=12;" vertex="1" parent="1">
