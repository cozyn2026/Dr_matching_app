      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;博士人材・大学院研究室マッチングアプリ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#64756c&quot;&gt;初期版システム構成｜React + Spring Boot + PostgreSQL（Docker）&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#20352b;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1250" height="52" as="geometry" />
        </mxCell>
        <mxCell id="researcher" value="&lt;b&gt;会員企業の研究者&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PC / スマートフォン&lt;br&gt;研究室検索・相談申込み&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;strokeWidth=1.4;fillColor=#FFFFFF;strokeColor=#B8C8BC;fontColor=#294337;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="185" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="university-user" value="&lt;b&gt;会員大学の担当者&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PC / スマートフォン&lt;br&gt;研究室情報・相談回答&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;strokeWidth=1.4;fillColor=#FFFFFF;strokeColor=#B8C8BC;fontColor=#294337;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="office-user" value="&lt;b&gt;コンソーシアム事務局&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;管理ブラウザ&lt;br&gt;会員・掲載情報の管理&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;strokeWidth=1.4;fillColor=#FFFFFF;strokeColor=#B8C8BC;fontColor=#294337;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="495" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="edge" value="&lt;b&gt;HTTPS入口&lt;/b&gt;&lt;br&gt;WAF / TLS終端&lt;br&gt;リバースプロキシ&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;公開ポート：443&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;strokeWidth=1.6;fillColor=#FFF4E7;strokeColor=#D99A57;fontColor=#674726;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="340" y="335" width="220" height="145" as="geometry" />
        </mxCell>
        <mxCell id="docker-boundary" value="&lt;b&gt;Docker Compose環境&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6d7e73&quot;&gt;内部ネットワーク｜DBポートは外部公開しない&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fontSize=16;fontStyle=1;fillColor=#F6F8F4;strokeColor=#7C9B89;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="630" y="90" width="970" height="790" as="geometry" />
        </mxCell>
        <mxCell id="web" value="&lt;b&gt;Webコンテナ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#286149&quot;&gt;&lt;b&gt;Nginx + React&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;Reactビルド資産を配信&lt;br&gt;画面・ナビゲーション・フォーム&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#63756a&quot;&gt;/api をSpring Bootへ中継&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.6;fillColor=#E8F2E9;strokeColor=#4C8664;fontColor=#254835;fontSize=14;" vertex="1" parent="docker-boundary">
          <mxGeometry x="45" y="110" width="330" height="205" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;アプリケーションコンテナ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#365D8A&quot;&gt;&lt;b&gt;Spring Boot REST API&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;認証・会員管理　｜　権限管理&lt;br&gt;研究者プロフィール　｜　研究室カタログ・検索&lt;br&gt;お気に入り　｜　相談・回答・面談候補&lt;br&gt;事務局管理・監査記録&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#63756a&quot;&gt;JSON / サーバ側で認証・認可・入力検証&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.6;fillColor=#EAF1FA;strokeColor=#6487AF;fontColor=#283F59;fontSize=14;" vertex="1" parent="docker-boundary">
          <mxGeometry x="420" y="110" width="500" height="255" as="geometry" />
        </mxCell>
        <mxCell id="postgres" value="&lt;b&gt;データベースコンテナ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#785F27&quot;&gt;&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;会員・利用者・プロフィール&lt;br&gt;研究室・受入れ条件・研究分野&lt;br&gt;お気に入り・相談・回答履歴・同意・監査記録&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#63756a&quot;&gt;内部接続：5432　外部公開なし&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.6;fillColor=#F8F1DD;strokeColor=#B79C58;fontColor=#574A2B;fontSize=14;" vertex="1" parent="docker-boundary">
          <mxGeometry x="420" y="425" width="500" height="190" as="geometry" />
        </mxCell>
        <mxCell id="volume" value="&lt;b&gt;Docker Volume&lt;/b&gt;&lt;br&gt;PostgreSQL永続データ&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#63756a&quot;&gt;コンテナ再作成後も保持&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;strokeColor=#B79C58;fillColor=#FFFDF6;fontColor=#574A2B;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="420" y="690" width="500" height="90" as="geometry" />
